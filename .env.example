# Contoh — salin ke `.env` lalu isi. JANGAN commit file `.env` (sudah di .gitignore).
# Vercel: isi yang sama di Project Settings > Environment Variables.
# EAS (APK): eas secret:create --scope project --name <NAMA> --value <NILAI>

# EmailJS (https://dashboard.emailjs.com > Email Services / Templates / Account)
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_WELCOME_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_RESET_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_CHANGED_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=

# Supabase — HANYA dipakai build native (APK). Web selalu mode lokal.
# (https://supabase.com/dashboard > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
